<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation=" http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cloud.imagey</groupId>
  <artifactId>imagey-web</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Imagey Web</name>
  <packaging>jar</packaging>

  <description>
    Imagey Web App.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <skipTests>false</skipTests>
    <!-- The instrumented bundle for the E2E suite (see the profile); skipped unless E2E runs -->
    <skipCoverageBundle>true</skipCoverageBundle>
  </properties>

  <profiles>
    <profile>
      <!-- A build that runs the E2E tests (no -DskipE2E) needs the instrumented bundle -->
      <id>e2e-coverage-bundle</id>
      <activation>
        <property>
          <name>!skipE2E</name>
        </property>
      </activation>
      <properties>
        <skipCoverageBundle>false</skipCoverageBundle>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <nodeVersion>v22.18.0</nodeVersion>
        </configuration>
        <executions>
          <execution>
            <id>install node and npm</id>
            <phase>initialize</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
          </execution>
          <execution>
            <id>npm install</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>
          <execution>
            <id>lint</id>
            <phase>process-sources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run lint</arguments>
            </configuration>
          </execution>
          <execution>
            <id>build</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
          <execution>
            <id>build instrumented bundle</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <arguments>run build:coverage</arguments>
              <skip>${skipCoverageBundle}</skip>
            </configuration>
          </execution>
          <execution>
            <id>install playwright browsers</id>
            <goals>
              <goal>npx</goal>
            </goals>
            <phase>generate-test-resources</phase>
            <configuration>
              <arguments>playwright install chromium</arguments>
              <skip>${skipTests}</skip>
            </configuration>
          </execution>
          <execution>
            <id>test</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <arguments>run test:coverage</arguments>
              <skip>${skipTests}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-js</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/resources/</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/dist/</directory>
                </resource>
              </resources>              
            </configuration>
          </execution>
          <execution>
            <id>copy-instrumented-js</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <skip>${skipCoverageBundle}</skip>
              <outputDirectory>${project.build.directory}/coverage-classes/META-INF/resources/</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/dist-coverage/</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
          <execution>
            <!-- The same frontend, instrumented, for the E2E suite; not a dependency of the server -->
            <id>coverage-jar</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <classifier>coverage</classifier>
              <classesDirectory>${project.build.directory}/coverage-classes</classesDirectory>
              <skipIfEmpty>true</skipIfEmpty>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
